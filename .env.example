# Copy to .env for local development. Never commit a real .env.
# Vars are grouped by the implementation phase that introduces them
# (see /Users/joecrismolina/.claude/plans/i-want-to-create-proud-dusk.md).

# --- Phase 1: core ---
APP_ENV=development
PORT=8080
LOG_LEVEL=debug

# --- Phase 2: Auth0 ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_CALLBACK_URL=http://localhost:8080/bff/auth/callback
# The SPA's local dev server (Vite default), not the backend API.
AUTH0_LOGOUT_REDIRECT_URL=http://localhost:5173
# Optional: where the browser lands after a successful login, if it should
# differ from AUTH0_LOGOUT_REDIRECT_URL (defaults to that value when unset).
POST_LOGIN_REDIRECT_URL=

# --- Phase 3: session / Redis ---
# Local: redis://localhost:6379 (docker-compose). Non-prod/prod: Upstash rediss:// URL.
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=__Host-tdff-session
SESSION_TTL_SECONDS=604800

# --- Phase 4: backend API proxy ---
BACKEND_API_BASE_URL=http://localhost:3000
